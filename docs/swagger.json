{
    "schemes": [
        "http",
        "https"
    ],
    "swagger": "2.0",
    "info": {
        "description": "This is the API for LVerity, a device management and licensing system.",
        "title": "LVerity API",
        "termsOfService": "http://swagger.io/terms/",
        "contact": {
            "name": "API Support",
            "url": "http://www.swagger.io/support",
            "email": "support@swagger.io"
        },
        "license": {
            "name": "Apache 2.0",
            "url": "http://www.apache.org/licenses/LICENSE-2.0.html"
        },
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/api",
    "paths": {
        "/api/v1/alerts": {
            "get": {
                "description": "获取系统中指定状态的所有告警",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "告警管理"
                ],
                "summary": "获取指定状态的告警列表",
                "parameters": [
                    {
                        "type": "string",
                        "description": "告警状态",
                        "name": "status",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/LVerity_pkg_model.Alert"
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/pkg_handler.ErrorResponse"
                        }
                    }
                }
            },
            "post": {
                "description": "为指定设备创建一个新的告警记录",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "告警管理"
                ],
                "summary": "创建新的告警",
                "parameters": [
                    {
                        "description": "告警信息",
                        "name": "alert",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/pkg_handler.CreateAlertRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/LVerity_pkg_model.Alert"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/pkg_handler.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/alerts/count": {
            "get": {
                "description": "获取指定设备和状态的告警数量",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "告警管理"
                ],
                "summary": "获取告警数量",
                "parameters": [
                    {
                        "type": "string",
                        "description": "设备ID",
                        "name": "deviceId",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "告警状态",
                        "name": "status",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/pkg_handler.AlertCountResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/pkg_handler.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/alerts/timerange": {
            "get": {
                "description": "获取指定时间范围内的所有告警记录",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "告警管理"
                ],
                "summary": "获取时间范围内的告警",
                "parameters": [
                    {
                        "type": "string",
                        "description": "开始时间",
                        "name": "startTime",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "结束时间",
                        "name": "endTime",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/LVerity_pkg_model.Alert"
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/pkg_handler.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/alerts/{id}": {
            "get": {
                "description": "根据告警ID获取告警详细信息",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "告警管理"
                ],
                "summary": "获取告警详情",
                "parameters": [
                    {
                        "type": "string",
                        "description": "告警ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/LVerity_pkg_model.Alert"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/pkg_handler.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/alerts/{id}/status": {
            "put": {
                "description": "更新指定告警的状态",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "告警管理"
                ],
                "summary": "更新告警状态",
                "parameters": [
                    {
                        "type": "string",
                        "description": "告警ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "新状态",
                        "name": "status",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/pkg_handler.UpdateAlertStatusRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/pkg_handler.SuccessResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/pkg_handler.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/devices/nearby": {
            "get": {
                "description": "获取指定坐标点附近的设备列表",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "地理位置"
                ],
                "summary": "获取附近的设备",
                "parameters": [
                    {
                        "type": "number",
                        "description": "纬度",
                        "name": "latitude",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "number",
                        "description": "经度",
                        "name": "longitude",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "number",
                        "description": "半径(米)",
                        "name": "radius",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/LVerity_pkg_model.Device"
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/pkg_handler.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/devices/{deviceId}/alerts": {
            "get": {
                "description": "获取指定设备的所有告警记录",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "告警管理"
                ],
                "summary": "获取设备的告警列表",
                "parameters": [
                    {
                        "type": "string",
                        "description": "设备ID",
                        "name": "deviceId",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/LVerity_pkg_model.Alert"
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/pkg_handler.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/devices/{deviceId}/location": {
            "put": {
                "description": "更新指定设备的地理位置信息",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "地理位置"
                ],
                "summary": "更新设备位置信息",
                "parameters": [
                    {
                        "type": "string",
                        "description": "设备ID",
                        "name": "deviceId",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "位置信息",
                        "name": "location",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/pkg_handler.UpdateLocationRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/LVerity_pkg_model.DeviceLocationLog"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/pkg_handler.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/auth/login": {
            "post": {
                "description": "Authenticates a user and returns a JWT token.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "User login",
                "parameters": [
                    {
                        "description": "Login credentials",
                        "name": "login",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/LVerity_pkg_model.LoginRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful login",
                        "schema": {
                            "$ref": "#/definitions/LVerity_pkg_model.LoginResponse"
                        }
                    },
                    "400": {
                        "description": "Invalid input",
                        "schema": {
                            "$ref": "#/definitions/LVerity_pkg_model.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/LVerity_pkg_model.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/LVerity_pkg_model.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/devices": {
            "get": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "description": "Retrieves a paginated list of devices.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "devices"
                ],
                "summary": "List devices",
                "parameters": [
                    {
                        "type": "integer",
                        "default": 1,
                        "description": "Page number",
                        "name": "page",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "default": 10,
                        "description": "Items per page",
                        "name": "limit",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Filter by device status (e.g., active, inactive)",
                        "name": "status",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "List of devices",
                        "schema": {
                            "$ref": "#/definitions/LVerity_pkg_model.PaginatedDevicesResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/LVerity_pkg_model.ErrorResponse"
                        }
                    }
                }
            },
            "post": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "description": "Adds a new device to the system.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "devices"
                ],
                "summary": "Create a new device",
                "parameters": [
                    {
                        "description": "Device information",
                        "name": "device",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/LVerity_pkg_model.CreateDeviceRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Device created successfully\" // Using model.Device as DeviceResponse",
                        "schema": {
                            "$ref": "#/definitions/LVerity_pkg_model.Device"
                        }
                    },
                    "400": {
                        "description": "Invalid input",
                        "schema": {
                            "$ref": "#/definitions/LVerity_pkg_model.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/LVerity_pkg_model.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/devices/{id}": {
            "get": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "description": "Retrieves details for a specific device by its ID.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "devices"
                ],
                "summary": "Get device details",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Device ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Device details",
                        "schema": {
                            "$ref": "#/definitions/LVerity_pkg_model.Device"
                        }
                    },
                    "404": {
                        "description": "Device not found",
                        "schema": {
                            "$ref": "#/definitions/LVerity_pkg_model.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/LVerity_pkg_model.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/users": {
            "get": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "description": "Retrieves a paginated list of users.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "users"
                ],
                "summary": "List users",
                "parameters": [
                    {
                        "type": "integer",
                        "default": 1,
                        "description": "Page number",
                        "name": "page",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "default": 10,
                        "description": "Items per page",
                        "name": "limit",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "List of users",
                        "schema": {
                            "$ref": "#/definitions/LVerity_pkg_model.PaginatedUsersResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/LVerity_pkg_model.ErrorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "LVerity_pkg_model.Alert": {
            "type": "object",
            "properties": {
                "created_at": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                },
                "device_id": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "level": {
                    "$ref": "#/definitions/LVerity_pkg_model.AlertLevel"
                },
                "metadata": {
                    "type": "string"
                },
                "resolved_at": {
                    "type": "string"
                },
                "resolved_by": {
                    "type": "string"
                },
                "status": {
                    "$ref": "#/definitions/LVerity_pkg_model.AlertStatus"
                },
                "title": {
                    "type": "string"
                },
                "updated_at": {
                    "type": "string"
                }
            }
        },
        "LVerity_pkg_model.AlertLevel": {
            "type": "string",
            "enum": [
                "info",
                "warning",
                "error",
                "critical"
            ],
            "x-enum-comments": {
                "AlertLevelCritical": "严重",
                "AlertLevelError": "错误",
                "AlertLevelInfo": "信息",
                "AlertLevelWarning": "警告"
            },
            "x-enum-varnames": [
                "AlertLevelInfo",
                "AlertLevelWarning",
                "AlertLevelError",
                "AlertLevelCritical"
            ]
        },
        "LVerity_pkg_model.AlertStatus": {
            "type": "string",
            "enum": [
                "open",
                "closed",
                "resolved"
            ],
            "x-enum-varnames": [
                "AlertStatusOpen",
                "AlertStatusClosed",
                "AlertStatusResolved"
            ]
        },
        "LVerity_pkg_model.CreateDeviceRequest": {
            "type": "object",
            "required": [
                "name"
            ],
            "properties": {
                "bios": {
                    "type": "string",
                    "example": "BIOS_VERSION_XYZ"
                },
                "description": {
                    "description": "Added description",
                    "type": "string",
                    "example": "Office laptop"
                },
                "disk_id": {
                    "type": "string",
                    "example": "SATA_DISK_123"
                },
                "group_id": {
                    "description": "Added GroupID",
                    "type": "string",
                    "example": "group-uuid-123"
                },
                "motherboard": {
                    "type": "string",
                    "example": "MOTHERBOARD_ABC"
                },
                "name": {
                    "type": "string",
                    "example": "My New Device"
                },
                "type": {
                    "description": "Added type as it's a common field",
                    "type": "string",
                    "example": "Laptop"
                }
            }
        },
        "LVerity_pkg_model.Device": {
            "type": "object",
            "properties": {
                "alert_count": {
                    "type": "integer"
                },
                "bios": {
                    "type": "string"
                },
                "block_reason": {
                    "type": "string"
                },
                "block_time": {
                    "type": "string"
                },
                "created_at": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                },
                "disk_id": {
                    "type": "string"
                },
                "display_card": {
                    "type": "string"
                },
                "group": {
                    "$ref": "#/definitions/LVerity_pkg_model.DeviceGroup"
                },
                "group_id": {
                    "type": "string"
                },
                "heartbeat_rate": {
                    "type": "integer"
                },
                "id": {
                    "type": "string"
                },
                "language": {
                    "type": "string"
                },
                "last_alert_time": {
                    "type": "string"
                },
                "last_command": {
                    "type": "string"
                },
                "last_command_at": {
                    "type": "string"
                },
                "last_heartbeat": {
                    "type": "string"
                },
                "last_seen": {
                    "type": "string"
                },
                "license_id": {
                    "type": "string"
                },
                "metadata": {
                    "type": "string"
                },
                "motherboard": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "network_cards": {
                    "type": "string"
                },
                "resolution": {
                    "type": "string"
                },
                "risk_level": {
                    "type": "number"
                },
                "status": {
                    "type": "string"
                },
                "timezone": {
                    "type": "string"
                },
                "type": {
                    "type": "string"
                },
                "unblock_time": {
                    "type": "string"
                },
                "updated_at": {
                    "type": "string"
                },
                "usage_stats": {
                    "$ref": "#/definitions/LVerity_pkg_model.UsageStats"
                }
            }
        },
        "LVerity_pkg_model.DeviceGroup": {
            "type": "object",
            "properties": {
                "created_at": {
                    "type": "string"
                },
                "created_by": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                },
                "devices": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/LVerity_pkg_model.Device"
                    }
                },
                "id": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "updated_at": {
                    "type": "string"
                }
            }
        },
        "LVerity_pkg_model.DeviceLocationLog": {
            "type": "object",
            "properties": {
                "device_id": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "location": {
                    "$ref": "#/definitions/LVerity_pkg_model.Location"
                },
                "timestamp": {
                    "type": "string"
                }
            }
        },
        "LVerity_pkg_model.ErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string",
                    "example": "An error occurred"
                },
                "message": {
                    "type": "string",
                    "example": "Detailed error message"
                }
            }
        },
        "LVerity_pkg_model.Location": {
            "type": "object",
            "properties": {
                "city": {
                    "type": "string"
                },
                "country": {
                    "type": "string"
                },
                "latitude": {
                    "type": "number"
                },
                "longitude": {
                    "type": "number"
                }
            }
        },
        "LVerity_pkg_model.LoginRequest": {
            "type": "object",
            "required": [
                "password",
                "username"
            ],
            "properties": {
                "password": {
                    "type": "string",
                    "example": "password123"
                },
                "username": {
                    "type": "string",
                    "example": "admin"
                }
            }
        },
        "LVerity_pkg_model.LoginResponse": {
            "type": "object",
            "properties": {
                "token": {
                    "type": "string",
                    "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
                },
                "user": {
                    "description": "Assuming User struct is defined in user.go or another model file",
                    "allOf": [
                        {
                            "$ref": "#/definitions/LVerity_pkg_model.User"
                        }
                    ]
                }
